# ===== Backend (Express + Prisma) =====
PORT=4000
NODE_ENV=development

# SuperTokens
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
SUPERTOKENS_API_KEY=
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173
SUPERTOKENS_API_DOMAIN=http://localhost:4000

# PostgreSQL (Prisma)
DATABASE_URL=postgresql://artisthive:artisthive@localhost:5432/artisthive?schema=public

# Auth secrets
JWT_SECRET=change-me
OTP_EMAIL_FROM=Artisthive <no-reply@yourdomain.com>

# Email (Resend or Brevo) — transactional email API for OTP delivery
EMAIL_API_PROVIDER=resend   # resend | brevo
RESEND_API_KEY=
BREVO_API_KEY=

# Media (local disk on VPS)
MEDIA_DIR=./media
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media

# ===== Web app (Vite) =====
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:4000

# ===== Admin app (Vite) =====
ADMIN_PORT=5174