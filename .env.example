# ===== Domains (used by Caddy + backend CORS + Vite builds) =====
# Use real domains on the VPS. Examples:
# WEB_DOMAIN=https://artisthive.yourdomain.com
# ADMIN_DOMAIN=https://admin.artisthive.yourdomain.com
# API_DOMAIN=https://api.artisthive.yourdomain.com
WEB_DOMAIN=http://localhost:5173
ADMIN_DOMAIN=http://localhost:5174
API_DOMAIN=http://localhost:4000

# ===== Database =====
POSTGRES_PASSWORD=artisthive

# ===== SuperTokens =====
# Generate with: openssl rand -base64 32
SUPERTOKENS_API_KEY=

# ===== App secrets =====
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me

# ===== Email (OTP delivery) =====
# provider: resend | brevo
EMAIL_API_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
OTP_EMAIL_FROM=Artisthive <no-reply@yourdomain.com>

# ===== Backend (kept for local runs; overridden inside containers) =====
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://artisthive:artisthive@localhost:5432/artisthive?schema=public
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:5173
SUPERTOKENS_API_DOMAIN=http://localhost:4000
MEDIA_DIR=./media
PUBLIC_MEDIA_BASE_URL=http://localhost:4000/media
VITE_API_BASE_URL=http://localhost:4000