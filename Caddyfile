# Artisthive reverse proxy.
# Set WEB_DOMAIN, ADMIN_DOMAIN, API_DOMAIN in your environment before `docker compose up`.
# Caddy auto-provisions HTTPS via Let's Encrypt for real domains.

{$WEB_DOMAIN:http://localhost:5173} {
    reverse_proxy web:80
}

{$ADMIN_DOMAIN:http://localhost:5174} {
    reverse_proxy admin:80
}

{$API_DOMAIN:http://localhost:4000} {
    reverse_proxy backend:4000
}